# Runtime
NODE_ENV=development
API_PORT=5050
API_RATE_LIMIT_WINDOW_MS=60000
API_RATE_LIMIT_MAX=120
API_REQUEST_TIMEOUT_MS=15000
WEB_ORIGIN=http://localhost:5173
API_ORIGIN=http://localhost:5050
LOG_LEVEL=info

# Database and queues
DATABASE_URL=postgresql://slabx:slabx@localhost:5432/slabx
DIRECT_DATABASE_URL=postgresql://slabx:slabx@localhost:5432/slabx
REDIS_URL=redis://localhost:6379

# Authentication: generate unique high-entropy values; never commit real ones
SESSION_SECRET=replace-with-at-least-32-random-bytes
CSRF_SECRET=replace-with-at-least-32-random-bytes
PASSWORD_PEPPER=replace-with-a-separately-managed-secret
GOOGLE_CLIENT_ID=replace-with-google-client-id
GOOGLE_CLIENT_SECRET=replace-with-google-client-secret
GOOGLE_CALLBACK_URL=http://localhost:5050/api/v1/auth/google/callback

# Providers
STRIPE_SECRET_KEY=sk_test_replace_me
STRIPE_WEBHOOK_SECRET=whsec_replace_me
EASYPOST_API_KEY=EZTK_replace_me
EASYPOST_WEBHOOK_SECRET=replace-with-at-least-24-random-characters
CLOUDINARY_CLOUD_NAME=replace_me
CLOUDINARY_API_KEY=replace_me
CLOUDINARY_API_SECRET=replace_me

# Email and observability
EMAIL_FROM=SlabX <no-reply@example.test>
EMAIL_PROVIDER_API_KEY=replace_me
SENTRY_DSN=
