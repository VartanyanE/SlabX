{
  "name": "slabx",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@11.16.0",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "dev": "turbo dev",
    "build": "turbo build",
    "lint": "turbo lint",
    "typecheck": "turbo typecheck",
    "test": "turbo test",
    "test:e2e": "playwright test",
    "test:load": "node scripts/load-smoke.mjs",
    "check": "pnpm lint && pnpm typecheck && pnpm test && pnpm build && pnpm openapi:check",
    "db:generate": "pnpm --filter @slabx/database db:generate",
    "db:migrate": "pnpm --filter @slabx/database db:migrate",
    "db:seed": "pnpm --filter @slabx/database db:seed",
    "db:staging:prepare": "pnpm --filter @slabx/database db:migrate:deploy && pnpm --filter @slabx/database db:seed",
    "openapi:generate": "pnpm --filter @slabx/api openapi:generate",
    "openapi:check": "pnpm openapi:generate && git diff --exit-code -- docs/openapi.json",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "@eslint/js": "^9.39.2",
    "@playwright/test": "^1.55.0",
    "@types/node": "^24.3.1",
    "eslint": "^9.39.2",
    "globals": "^16.3.0",
    "prettier": "^3.6.2",
    "turbo": "^2.10.9",
    "typescript": "^6.0.2",
    "typescript-eslint": "^8.44.0"
  }
}
