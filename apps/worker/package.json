{
  "name": "@slabx/worker",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx --conditions=development watch src/index.ts",
    "start": "node dist/index.js",
    "build": "tsc -p tsconfig.json",
    "lint": "eslint src",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run --passWithNoTests"
  },
  "dependencies": {
    "@slabx/config": "workspace:*",
    "@slabx/observability": "workspace:*"
  },
  "devDependencies": {
    "tsx": "^4.20.5",
    "vitest": "^4.1.10"
  }
}
