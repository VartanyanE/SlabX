{
  "name": "@slabx/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --conditions=development src/server.ts",
    "start": "node dist/server.js",
    "build": "tsc -p tsconfig.json",
    "lint": "eslint src",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run src",
    "openapi:generate": "tsx src/openapi/generate.ts"
  },
  "dependencies": {
    "@slabx/config": "workspace:*",
    "@slabx/contracts": "workspace:*",
    "@slabx/database": "workspace:*",
    "@slabx/observability": "workspace:*",
    "argon2": "^0.45.1",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^17.2.2",
    "express": "^5.2.1",
    "express-rate-limit": "^8.6.2",
    "helmet": "^8.1.0",
    "openid-client": "^6.8.4",
    "pg": "^8.16.3",
    "pino": "^9.9.4",
    "pino-http": "^11.0.0",
    "stripe": "^22.4.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/cookie-parser": "^1.4.9",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.3",
    "@types/pg": "^8.15.5",
    "@types/supertest": "^6.0.3",
    "supertest": "^7.1.4",
    "tsx": "^4.20.5",
    "vitest": "^4.1.10"
  }
}
