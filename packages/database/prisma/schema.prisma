generator client {
  provider = "prisma-client"
  output   = "../generated/client"
}

datasource db {
  provider = "postgresql"
}

enum UserStatus {
  PENDING_VERIFICATION
  ACTIVE
  SUSPENDED
  CLOSED
}

enum EmailTokenType {
  VERIFICATION
  PASSWORD_RESET
  EMAIL_CHANGE
}

enum AuthProvider {
  GOOGLE
}

enum SellerStatus {
  NOT_STARTED
  PENDING
  ACTIVE
  RESTRICTED
}

enum CatalogCardStatus {
  PENDING_REVIEW
  ACTIVE
  MERGED
  REJECTED
}

enum CollectionConditionType {
  RAW
  GRADED
}

enum RawCondition {
  POOR
  FAIR
  GOOD
  VERY_GOOD
  EXCELLENT
  NEAR_MINT
  MINT
}

enum CollectionVisibility {
  PRIVATE
  PUBLIC
}

enum CollectionAvailability {
  AVAILABLE
  NOT_FOR_SALE
  LISTED
  RESERVED
  SOLD
  TRADE_LOCKED
}

enum MediaModerationStatus {
  PENDING
  APPROVED
  REJECTED
}

enum ListingStatus {
  DRAFT
  ACTIVE
  PAUSED
  RESERVED
  CLOSED
}

enum OfferThreadStatus {
  OPEN
  ACCEPTED
  DECLINED
  CANCELLED
  EXPIRED
}

enum OfferRevisionKind {
  OFFER
  COUNTER
}

enum ConnectedAccountStatus {
  PENDING
  ACTIVE
  RESTRICTED
}

enum OrderStatus {
  PENDING_PAYMENT
  PAID
  PAYMENT_FAILED
  CANCELLED
}

enum PaymentAttemptStatus {
  CREATED
  PROCESSING
  SUCCEEDED
  FAILED
  CANCELLED
}

model User {
  id              String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  emailNormalized String     @unique(map: "users_email_normalized_key") @map("email_normalized")
  emailDisplay    String     @map("email_display")
  emailVerifiedAt DateTime?  @map("email_verified_at") @db.Timestamptz(6)
  status          UserStatus @default(PENDING_VERIFICATION)
  lastLoginAt     DateTime?  @map("last_login_at") @db.Timestamptz(6)
  createdAt       DateTime   @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime   @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt       DateTime?  @map("deleted_at") @db.Timestamptz(6)

  credential PasswordCredential?
  identities AuthIdentity[]
  sessions   Session[]
  emailTokens EmailToken[]
  profile    Profile?
  addresses  Address[]
  roles      UserRole[]
  auditEvents AuditEvent[]
  createdCatalogCards CatalogCard[] @relation("CatalogCardCreator")
  collectionItems CollectionItem[]
  mediaAssets     MediaAsset[]
  listings        Listing[]       @relation("ListingSeller")
  watchlist       WatchlistEntry[]
  buyerOfferThreads OfferThread[] @relation("OfferBuyer")
  sellerOfferThreads OfferThread[] @relation("OfferSeller")
  offerRevisions OfferRevision[]
  notifications Notification[]
  connectedAccount ConnectedAccount?
  buyerOrders Order[] @relation("OrderBuyer")
  sellerOrders Order[] @relation("OrderSeller")
  paymentAttempts PaymentAttempt[]

  @@index([status, createdAt])
  @@map("users")
}

model PasswordCredential {
  userId            String    @id @map("user_id") @db.Uuid
  passwordHash      String    @map("password_hash")
  passwordChangedAt DateTime  @default(now()) @map("password_changed_at") @db.Timestamptz(6)
  failedAttempts    Int       @default(0) @map("failed_attempts")
  lockedUntil       DateTime? @map("locked_until") @db.Timestamptz(6)
  user              User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("password_credentials")
}

model AuthIdentity {
  id              String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId          String       @map("user_id") @db.Uuid
  provider        AuthProvider
  providerSubject String       @map("provider_subject")
  providerEmail   String?      @map("provider_email")
  createdAt       DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime     @updatedAt @map("updated_at") @db.Timestamptz(6)
  user            User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerSubject])
  @@index([userId])
  @@map("auth_identities")
}

model Session {
  id            String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId        String    @map("user_id") @db.Uuid
  tokenHash     String    @unique @map("token_hash")
  csrfTokenHash String    @map("csrf_token_hash")
  expiresAt     DateTime  @map("expires_at") @db.Timestamptz(6)
  lastSeenAt    DateTime  @default(now()) @map("last_seen_at") @db.Timestamptz(6)
  revokedAt     DateTime? @map("revoked_at") @db.Timestamptz(6)
  ipHash        String?   @map("ip_hash")
  userAgentHash String?   @map("user_agent_hash")
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, revokedAt])
  @@index([expiresAt])
  @@map("sessions")
}

model EmailToken {
  id         String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId     String         @map("user_id") @db.Uuid
  type       EmailTokenType
  tokenHash  String         @unique @map("token_hash")
  expiresAt  DateTime       @map("expires_at") @db.Timestamptz(6)
  consumedAt DateTime?      @map("consumed_at") @db.Timestamptz(6)
  createdAt  DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)
  user       User           @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, type, consumedAt])
  @@map("email_tokens")
}

model Profile {
  userId           String       @id @map("user_id") @db.Uuid
  handleNormalized String       @unique @map("handle_normalized")
  handleDisplay    String       @map("handle_display")
  displayName      String       @map("display_name")
  bio              String?
  sellerStatus     SellerStatus @default(NOT_STARTED) @map("seller_status")
  ratingAverage    Decimal?     @map("rating_average") @db.Decimal(3, 2)
  ratingCount      Int          @default(0) @map("rating_count")
  createdAt        DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime     @updatedAt @map("updated_at") @db.Timestamptz(6)
  user             User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("profiles")
}

model Address {
  id                String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId            String    @map("user_id") @db.Uuid
  label             String
  recipientName     String    @map("recipient_name")
  line1             String
  line2             String?
  city              String
  region            String
  postalCode        String    @map("postal_code")
  countryCode       String    @map("country_code") @db.Char(2)
  isDefaultShipping Boolean   @default(false) @map("is_default_shipping")
  createdAt         DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt         DateTime? @map("deleted_at") @db.Timestamptz(6)
  user              User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, deletedAt])
  @@map("addresses")
}

model Role {
  id          String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  code        String     @unique
  name        String
  permissions RolePermission[]
  users       UserRole[]

  @@map("roles")
}

model Permission {
  id    String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  code  String @unique
  name  String
  roles RolePermission[]

  @@map("permissions")
}

model RolePermission {
  roleId       String     @map("role_id") @db.Uuid
  permissionId String     @map("permission_id") @db.Uuid
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@map("role_permissions")
}

model UserRole {
  userId    String   @map("user_id") @db.Uuid
  roleId    String   @map("role_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  role      Role     @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([userId, roleId])
  @@map("user_roles")
}

model AuditEvent {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  actorUserId String?  @map("actor_user_id") @db.Uuid
  action     String
  targetType String?  @map("target_type")
  targetId   String?  @map("target_id")
  metadata   Json     @default("{}")
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  actor      User?    @relation(fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([actorUserId, createdAt])
  @@index([action, createdAt])
  @@map("audit_events")
}

model Category {
  id               String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  slug             String   @unique
  name             String
  kind             String
  attributesSchema Json     @default("{}") @map("attributes_schema")
  active           Boolean  @default(true)
  sortOrder        Int      @default(0) @map("sort_order")
  createdAt        DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)
  cardSets         CardSet[]
  catalogCards     CatalogCard[]

  @@map("categories")
}

model Manufacturer {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  nameNormalized String   @unique @map("name_normalized")
  nameDisplay    String   @map("name_display")
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  cardSets       CardSet[]

  @@map("manufacturers")
}

model CardSet {
  id             String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  categoryId     String       @map("category_id") @db.Uuid
  manufacturerId String       @map("manufacturer_id") @db.Uuid
  name           String
  nameNormalized String       @map("name_normalized")
  yearStart      Int          @map("year_start")
  yearEnd        Int?         @map("year_end")
  createdAt      DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  category       Category     @relation(fields: [categoryId], references: [id])
  manufacturer   Manufacturer @relation(fields: [manufacturerId], references: [id])
  cards          CatalogCard[]

  @@unique([categoryId, manufacturerId, nameNormalized, yearStart])
  @@index([categoryId, yearStart])
  @@map("card_sets")
}

model CatalogCard {
  id                    String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  categoryId            String            @map("category_id") @db.Uuid
  cardSetId             String            @map("card_set_id") @db.Uuid
  playerOrCharacter     String            @map("player_or_character")
  playerNormalized      String            @map("player_normalized")
  year                  Int
  cardNumber            String            @map("card_number")
  subset                String?
  variant               String?
  languageCode          String            @default("en") @map("language_code") @db.Char(2)
  isRookie              Boolean           @default(false) @map("is_rookie")
  isAutograph           Boolean           @default(false) @map("is_autograph")
  isMemorabilia         Boolean           @default(false) @map("is_memorabilia")
  serialTotal           Int?              @map("serial_total")
  attributes            Json              @default("{}")
  fingerprint           String            @unique
  status                CatalogCardStatus @default(PENDING_REVIEW)
  createdByUserId       String?           @map("created_by_user_id") @db.Uuid
  mergedIntoId          String?           @map("merged_into_id") @db.Uuid
  createdAt             DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt             DateTime          @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt             DateTime?         @map("deleted_at") @db.Timestamptz(6)
  category              Category          @relation(fields: [categoryId], references: [id])
  cardSet               CardSet           @relation(fields: [cardSetId], references: [id])
  createdBy             User?             @relation("CatalogCardCreator", fields: [createdByUserId], references: [id], onDelete: SetNull)
  mergedInto            CatalogCard?      @relation("CatalogMerge", fields: [mergedIntoId], references: [id])
  mergedCards           CatalogCard[]     @relation("CatalogMerge")
  collectionItems       CollectionItem[]

  @@index([categoryId, year, status])
  @@index([cardSetId, cardNumber])
  @@index([playerNormalized])
  @@map("catalog_cards")
}

model GradingCompany {
  id                          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  code                        String   @unique
  name                        String
  gradeScale                  Json     @map("grade_scale")
  certVerificationUrlTemplate String?  @map("cert_verification_url_template")
  active                      Boolean  @default(true)
  createdAt                   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  collectionItems             CollectionItem[]

  @@map("grading_companies")
}

model CollectionItem {
  id                  String                 @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  ownerUserId         String                 @map("owner_user_id") @db.Uuid
  catalogCardId       String                 @map("catalog_card_id") @db.Uuid
  conditionType       CollectionConditionType @map("condition_type")
  rawCondition        RawCondition?          @map("raw_condition")
  gradingCompanyId    String?                @map("grading_company_id") @db.Uuid
  grade               Decimal?               @db.Decimal(4, 2)
  certificationNumber String?                @map("certification_number")
  itemNotes           String?                @map("item_notes")
  visibility          CollectionVisibility   @default(PRIVATE)
  availabilityStatus  CollectionAvailability @default(NOT_FOR_SALE) @map("availability_status")
  acquiredAt          DateTime?              @map("acquired_at") @db.Date
  acquisitionPriceMinor Int?                 @map("acquisition_price_minor")
  version             Int                    @default(1)
  createdAt           DateTime               @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt           DateTime               @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt           DateTime?              @map("deleted_at") @db.Timestamptz(6)
  owner               User                   @relation(fields: [ownerUserId], references: [id], onDelete: Cascade)
  catalogCard         CatalogCard            @relation(fields: [catalogCardId], references: [id])
  gradingCompany      GradingCompany?        @relation(fields: [gradingCompanyId], references: [id])
  media               ItemMedia[]
  listings            Listing[]

  @@index([ownerUserId, availabilityStatus, deletedAt])
  @@index([catalogCardId])
  @@index([gradingCompanyId, certificationNumber])
  @@map("collection_items")
}

model Listing {
  id                  String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  sellerUserId        String           @map("seller_user_id") @db.Uuid
  collectionItemId    String           @map("collection_item_id") @db.Uuid
  status              ListingStatus    @default(DRAFT)
  priceMinor          BigInt           @map("price_minor")
  currency            String           @default("USD") @db.Char(3)
  acceptsOffers       Boolean          @default(false) @map("accepts_offers")
  minimumOfferMinor   BigInt?          @map("minimum_offer_minor")
  conditionDisclosure String           @map("condition_disclosure")
  publishedAt         DateTime?        @map("published_at") @db.Timestamptz(6)
  reservedByUserId    String?          @map("reserved_by_user_id") @db.Uuid
  reservedUntil       DateTime?        @map("reserved_until") @db.Timestamptz(6)
  reservationReason   String?          @map("reservation_reason")
  version             Int              @default(1)
  createdAt           DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt           DateTime         @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt           DateTime?        @map("deleted_at") @db.Timestamptz(6)
  seller              User             @relation("ListingSeller", fields: [sellerUserId], references: [id], onDelete: Restrict)
  collectionItem      CollectionItem   @relation(fields: [collectionItemId], references: [id], onDelete: Restrict)
  priceHistory        ListingPriceHistory[]
  watchers            WatchlistEntry[]
  offerThreads         OfferThread[]
  orders               Order[]

  @@index([status, publishedAt(sort: Desc)])
  @@index([sellerUserId, status])
  @@index([priceMinor])
  @@index([collectionItemId])
  @@map("listings")
}

model OfferThread {
  id                 String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  listingId          String            @map("listing_id") @db.Uuid
  buyerUserId        String            @map("buyer_user_id") @db.Uuid
  sellerUserId       String            @map("seller_user_id") @db.Uuid
  status             OfferThreadStatus @default(OPEN)
  currentRevisionId  String?           @map("current_revision_id") @db.Uuid
  acceptedPriceMinor BigInt?           @map("accepted_price_minor")
  checkoutExpiresAt  DateTime?         @map("checkout_expires_at") @db.Timestamptz(6)
  version            Int               @default(1)
  createdAt          DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt          DateTime          @updatedAt @map("updated_at") @db.Timestamptz(6)
  listing            Listing           @relation(fields: [listingId], references: [id], onDelete: Cascade)
  buyer              User              @relation("OfferBuyer", fields: [buyerUserId], references: [id], onDelete: Restrict)
  seller             User              @relation("OfferSeller", fields: [sellerUserId], references: [id], onDelete: Restrict)
  revisions          OfferRevision[]
  orders             Order[]

  @@index([buyerUserId, status, updatedAt(sort: Desc)])
  @@index([sellerUserId, status, updatedAt(sort: Desc)])
  @@index([listingId, status])
  @@map("offer_threads")
}

model OfferRevision {
  id          String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  threadId    String            @map("thread_id") @db.Uuid
  actorUserId String            @map("actor_user_id") @db.Uuid
  kind        OfferRevisionKind
  amountMinor BigInt            @map("amount_minor")
  message     String?
  idempotencyKey String          @unique @map("idempotency_key") @db.Uuid
  expiresAt   DateTime          @map("expires_at") @db.Timestamptz(6)
  createdAt   DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)
  thread      OfferThread       @relation(fields: [threadId], references: [id], onDelete: Cascade)
  actor       User              @relation(fields: [actorUserId], references: [id], onDelete: Restrict)

  @@index([threadId, createdAt])
  @@index([expiresAt])
  @@map("offer_revisions")
}

model Notification {
  id        String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  type      String
  payload   Json
  readAt    DateTime? @map("read_at") @db.Timestamptz(6)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, readAt, createdAt(sort: Desc)])
  @@map("notifications")
}

model OutboxEvent {
  id          String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  topic       String
  aggregateId String    @map("aggregate_id")
  payload     Json
  availableAt DateTime  @default(now()) @map("available_at") @db.Timestamptz(6)
  processedAt DateTime? @map("processed_at") @db.Timestamptz(6)
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([processedAt, availableAt])
  @@map("outbox_events")
}

model ConnectedAccount {
  id                    String                 @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId                String                 @unique @map("user_id") @db.Uuid
  providerAccountId     String                 @unique @map("provider_account_id")
  status                ConnectedAccountStatus @default(PENDING)
  detailsSubmitted      Boolean                @default(false) @map("details_submitted")
  chargesEnabled        Boolean                @default(false) @map("charges_enabled")
  payoutsEnabled        Boolean                @default(false) @map("payouts_enabled")
  requirementsCurrentlyDue Json                @default("[]") @map("requirements_currently_due")
  createdAt             DateTime               @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt             DateTime               @updatedAt @map("updated_at") @db.Timestamptz(6)
  user                  User                   @relation(fields: [userId], references: [id], onDelete: Restrict)
  orders                Order[]

  @@map("connected_accounts")
}

model Order {
  id                 String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  orderNumber        String      @unique @map("order_number")
  buyerUserId        String      @map("buyer_user_id") @db.Uuid
  sellerUserId       String      @map("seller_user_id") @db.Uuid
  listingId          String      @map("listing_id") @db.Uuid
  offerThreadId      String?     @map("offer_thread_id") @db.Uuid
  connectedAccountId String      @map("connected_account_id") @db.Uuid
  status             OrderStatus @default(PENDING_PAYMENT)
  currency           String      @default("USD") @db.Char(3)
  subtotalMinor      BigInt      @map("subtotal_minor")
  platformFeeMinor   BigInt      @map("platform_fee_minor")
  sellerProceedsMinor BigInt     @map("seller_proceeds_minor")
  shippingAddressSnapshot Json?  @map("shipping_address_snapshot")
  paidAt             DateTime?   @map("paid_at") @db.Timestamptz(6)
  createdAt          DateTime    @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt          DateTime    @updatedAt @map("updated_at") @db.Timestamptz(6)
  buyer              User        @relation("OrderBuyer", fields: [buyerUserId], references: [id], onDelete: Restrict)
  seller             User        @relation("OrderSeller", fields: [sellerUserId], references: [id], onDelete: Restrict)
  listing            Listing     @relation(fields: [listingId], references: [id], onDelete: Restrict)
  offerThread        OfferThread? @relation(fields: [offerThreadId], references: [id], onDelete: Restrict)
  connectedAccount   ConnectedAccount @relation(fields: [connectedAccountId], references: [id], onDelete: Restrict)
  item               OrderItem?
  paymentAttempts    PaymentAttempt[]
  ledgerEntries      LedgerEntry[]

  @@index([buyerUserId, createdAt(sort: Desc)])
  @@index([sellerUserId, createdAt(sort: Desc)])
  @@index([listingId, status])
  @@map("orders")
}

model OrderItem {
  id                      String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  orderId                 String   @unique @map("order_id") @db.Uuid
  listingSnapshot         Json     @map("listing_snapshot")
  collectionItemSnapshot  Json     @map("collection_item_snapshot")
  catalogCardSnapshot     Json     @map("catalog_card_snapshot")
  createdAt               DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  order                   Order    @relation(fields: [orderId], references: [id], onDelete: Restrict)

  @@map("order_items")
}

model PaymentAttempt {
  id                     String               @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  orderId                String               @map("order_id") @db.Uuid
  buyerUserId            String               @map("buyer_user_id") @db.Uuid
  idempotencyKey         String               @unique @map("idempotency_key") @db.Uuid
  providerCheckoutId     String?              @unique @map("provider_checkout_id")
  providerPaymentIntentId String?              @unique @map("provider_payment_intent_id")
  status                 PaymentAttemptStatus @default(CREATED)
  failureCode            String?              @map("failure_code")
  failureMessage         String?              @map("failure_message")
  createdAt              DateTime             @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt              DateTime             @updatedAt @map("updated_at") @db.Timestamptz(6)
  order                  Order                @relation(fields: [orderId], references: [id], onDelete: Restrict)
  buyer                  User                 @relation(fields: [buyerUserId], references: [id], onDelete: Restrict)

  @@index([orderId, createdAt(sort: Desc)])
  @@map("payment_attempts")
}

model LedgerEntry {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  orderId     String   @map("order_id") @db.Uuid
  accountCode String   @map("account_code")
  amountMinor BigInt   @map("amount_minor")
  currency    String   @default("USD") @db.Char(3)
  description String
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  order       Order    @relation(fields: [orderId], references: [id], onDelete: Restrict)

  @@index([orderId, createdAt])
  @@map("ledger_entries")
}

model WebhookInbox {
  id              String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  provider        String
  providerEventId String    @map("provider_event_id")
  eventType       String    @map("event_type")
  payload         Json
  processedAt     DateTime? @map("processed_at") @db.Timestamptz(6)
  errorMessage    String?   @map("error_message")
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  @@unique([provider, providerEventId])
  @@index([processedAt, createdAt])
  @@map("webhook_inbox")
}

model ListingPriceHistory {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  listingId  String   @map("listing_id") @db.Uuid
  priceMinor BigInt   @map("price_minor")
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  listing    Listing  @relation(fields: [listingId], references: [id], onDelete: Cascade)

  @@index([listingId, createdAt(sort: Desc)])
  @@map("listing_price_history")
}

model WatchlistEntry {
  userId    String   @map("user_id") @db.Uuid
  listingId String   @map("listing_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  listing   Listing  @relation(fields: [listingId], references: [id], onDelete: Cascade)

  @@id([userId, listingId])
  @@index([listingId])
  @@map("watchlist_entries")
}

model MediaAsset {
  id               String                  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  ownerUserId      String                  @map("owner_user_id") @db.Uuid
  provider         String                  @default("cloudinary")
  providerAssetId  String                  @unique @map("provider_asset_id")
  publicId         String                  @unique @map("public_id")
  secureUrl        String                  @map("secure_url")
  format           String
  width            Int
  height           Int
  bytes            Int
  moderationStatus MediaModerationStatus   @default(PENDING) @map("moderation_status")
  createdAt        DateTime                @default(now()) @map("created_at") @db.Timestamptz(6)
  deletedAt        DateTime?               @map("deleted_at") @db.Timestamptz(6)
  owner            User                    @relation(fields: [ownerUserId], references: [id], onDelete: Cascade)
  items            ItemMedia[]

  @@index([ownerUserId, deletedAt])
  @@map("media_assets")
}

model ItemMedia {
  collectionItemId String         @map("collection_item_id") @db.Uuid
  mediaAssetId     String         @map("media_asset_id") @db.Uuid
  position         Int            @default(0)
  isPrimary        Boolean        @default(false) @map("is_primary")
  createdAt        DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)
  collectionItem   CollectionItem @relation(fields: [collectionItemId], references: [id], onDelete: Cascade)
  mediaAsset       MediaAsset     @relation(fields: [mediaAssetId], references: [id], onDelete: Cascade)

  @@id([collectionItemId, mediaAssetId])
  @@unique([collectionItemId, position])
  @@index([mediaAssetId])
  @@map("item_media")
}

model SystemMetadata {
  key       String   @id
  value     Json
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@map("system_metadata")
}
